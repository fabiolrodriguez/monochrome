[gd_resource type="Resource" script_class="LevelData" load_steps=12 format=3]

[ext_resource type="Script" path="res://src/data/levels/level_data.gd" id="1_level"]
[ext_resource type="Script" path="res://src/data/levels/spawn_segment_data.gd" id="2_segment"]
[ext_resource type="Resource" path="res://src/data/enemies/chaser.tres" id="3_chaser"]
[ext_resource type="Resource" path="res://src/data/enemies/shooter.tres" id="4_shooter"]
[ext_resource type="Resource" path="res://src/data/enemies/tank.tres" id="5_tank"]
[ext_resource type="Resource" path="res://src/data/objectives/survive_void_garden.tres" id="6_objective"]
[ext_resource type="Resource" path="res://src/data/bosses/the_watcher.tres" id="7_boss"]
[ext_resource type="Resource" path="res://src/data/enemies/elite_hunter.tres" id="8_elite"]

[sub_resource type="Resource" id="Segment_intro"]
script = ExtResource("2_segment")
starts_at_ratio = 0.0
budget_multiplier = 1.0
spawn_interval_multiplier = 1.0
maximum_active_enemies = 20

[sub_resource type="Resource" id="Segment_pressure"]
script = ExtResource("2_segment")
starts_at_ratio = 0.33
budget_multiplier = 1.35
spawn_interval_multiplier = 0.85
maximum_active_enemies = 30

[sub_resource type="Resource" id="Segment_climax"]
script = ExtResource("2_segment")
starts_at_ratio = 0.66
budget_multiplier = 1.8
spawn_interval_multiplier = 0.7
maximum_active_enemies = 45

[resource]
script = ExtResource("1_level")
id = &"void_garden"
name_key = &"LEVEL_VOID_GARDEN_NAME"
description_key = &"LEVEL_VOID_GARDEN_DESC"
duration = 360.0
objective = ExtResource("6_objective")
boss = ExtResource("7_boss")
enemy_pool = [ExtResource("3_chaser"), ExtResource("4_shooter"), ExtResource("5_tank")]
elite_pool = [ExtResource("8_elite")]
next_levels = Array[StringName]([&"dead_factory", &"white_forest"])
difficulty = 1.0
spawn_segments = [SubResource("Segment_intro"), SubResource("Segment_pressure"), SubResource("Segment_climax")]
