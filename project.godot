; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Monochrome"
config/version="0.1.0-playtest"
run/main_scene="res://src/app/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

SettingsManager="*res://src/settings/settings_manager.gd"
SaveManager="*res://src/persistence/save_manager.gd"
ProgressionManager="*res://src/progression/progression_manager.gd"
AudioManager="*res://src/presentation/audio/audio_manager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

